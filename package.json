{
  "name": "temml",
  "version": "0.14.0",
  "description": "TeX to MathML conversion in JavaScript.",
  "main": "dist/temml.js",
  "engines": {
    "node": ">=18.13.0"
  },
  "exports": {
    ".": {
      "require": "./dist/temml.cjs",
      "import": "./dist/temml.mjs",
      "types": "./dist/temml.d.ts"
    },
    "./*": "./*"
  },
  "homepage": "https://temml.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronkok/Temml.git"
  },
  "files": [
    "temml.ts",
    "src/",
    "contrib/",
    "dist/"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "rolldown": "^1.2.15",
    "rolldown-plugin-dts": "^0.30.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "lint": "eslint temml.ts src",
    "typecheck": "tsc",
    "unit-test": "vitest run",
    "test:watch": "vitest",
    "test": "pnpm lint && pnpm typecheck && pnpm unit-test",
    "build": "rolldown --config ./utils/rolldown.config.mjs && node utils/insertPlugins.js && node utils/copyfiles.js",
    "dist": "pnpm build"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.0.0 <13.0.0",
      "onFail": "download"
    }
  }
}
